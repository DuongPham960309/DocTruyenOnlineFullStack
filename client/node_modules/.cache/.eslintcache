  for (const novel of tempData) {\r\n    novel.image = getImageUrl(novel.image);\r\n  }\r\n\r\n  simpleNovelsData[name] = tempData;\r\n}\r\n\r\nexport type {TTableRowOfList, SimpleListName, TSimpleNovels, SimpleNovels};\r\nexport {simpleNovelsData, useUpdate, propsSimpleListOfNovels};","D:\\z_PresentOnComputer\\Code\\Web\\Fullstack\\DocTruyenOnlineFullStack\\client\\src\\features\\layouts\\main-layout\\shared\\CommonUI.tsx",[],[],{"ruleId":"78","severity":1,"message":"79","line":1,"column":9,"nodeType":"80","messageId":"81","endLine":1,"endColumn":22},{"ruleId":"78","severity":1,"message":"79","line":1,"column":9,"nodeType":"80","messageId":"81","endLine":1,"endColumn":22},{"ruleId":"78","severity":1,"message":"79","line":1,"column":9,"nodeType":"80","messageId":"81","endLine":1,"endColumn":22},{"ruleId":"78","severity":1,"message":"82","line":3,"column":9,"nodeType":"80","messageId":"81","endLine":3,"endColumn":17},{"ruleId":"83","severity":1,"message":"84","line":33,"column":6,"nodeType":"85","endLine":33,"endColumn":8,"suggestions":"86"},"@typescript-eslint/no-unused-vars","'propsFunction' is defined but never used.","Identifier","unusedVar","'tempData' is defined but never used.","react-hooks/exhaustive-deps","React Hook useEffect has a missing dependency: 'name'. Either include it or remove the dependency array.","ArrayExpression",["87"],{"desc":"88","fix":"89"},"Update the dependencies array to be: [name]",{"range":"90","text":"91"},[842,844],"[name]"]